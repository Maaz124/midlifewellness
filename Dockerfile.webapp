# Dockerfile for MidlifeWellness Web Application
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Production stage
FROM node:20-alpine AS production

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install production dependencies + drizzle-kit and typescript (needed for db:push)
RUN npm ci --omit=dev && \
    npm install drizzle-kit typescript --save-dev

# Copy built files from builder
COPY --from=builder /app/dist ./dist
# Copy shared folder (needed for drizzle-kit schema)
COPY --from=builder /app/shared ./shared
# Copy runtime directories (uploads, attached_assets)
COPY --from=builder /app/uploads ./uploads
COPY --from=builder /app/attached_assets ./attached_assets
# Copy config files needed for db:push
COPY --from=builder /app/drizzle.config.ts ./
COPY --from=builder /app/tsconfig.json ./

# Install su-exec for user switching in entrypoint
RUN apk add --no-cache su-exec

# Copy entrypoint script from build context
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Create uploads directory structure (entrypoint will handle permissions for volumes)
RUN mkdir -p /app/uploads/resources

# Expose port 5000 (internal container port)
EXPOSE 5000

# Set environment to production
ENV NODE_ENV=production
ENV PORT=5000

# Use entrypoint script
ENTRYPOINT ["docker-entrypoint.sh"]

# Start the application
CMD ["node", "dist/index.js"]

